# OpenAI Configuration
# Copy this file to .env and fill in your actual values
# WARNING: .env is in .gitignore - NEVER commit real secrets

# OpenAI API Key (required for OpenAI provider)
# Get from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# LLM Provider selection (ollama, openai, anthropic)
LLM_PROVIDER=openai

# Model selection (used by all providers)
# Options: gpt-4o-mini, gpt-4-turbo for OpenAI; qwen2.5:8b for Ollama
LLM_MODEL=gpt-4o-mini

# Ollama Configuration (if using local models)
# OLLAMA_MODEL=llama2
# OLLAMA_API_URL=http://localhost:11434

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
